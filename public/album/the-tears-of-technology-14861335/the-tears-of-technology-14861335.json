  "artists_wikipedia": {
    "Bob Stanley": {
      "biography": "Bob Stanley is a British musician, journalist, author, and film producer. He is a member of the indie pop group Saint Etienne and has had a parallel career as a music journalist and author, writing for NME, Melody Maker, Mojo, The Guardian and The Times, as well as writing several books on music and football. His second publication, Yeah! Yeah! Yeah!: The Story of Modern Pop, was published by Faber & Faber in 2013. His third publication Let's Do It: The Birth of Pop Music: A History was published by Pegasus in 2022. He also has a career as a DJ and as a producer of record labels, and has collaborated on a series of films about London.",
      "wikipedia_url": "https://en.wikipedia.org/wiki/Bob_Stanley_(musician)"
    },
    "Pete Wiggs": {
      "biography": "Pete Wiggs (born15 May 1966, Reigate, England) is an English musician, producer, songwriter and DJ, best known for being one third of Saint Etienne.\n\nSince the mid-2000's, he has completed a sizeable amount of remixes for other artists, mostly using Saint Etienne as an alias but also under his own name.\n\nIn December 2014, his first official solo recording effort was released - Saint Etienne Presents How We Used to Live, a soundtrack for the documentary film of the same name.\n\nHis second solo release was in April 2018 and was the soundtrack to the short film Abstractions of Holderness, made by Saint Etienne bandmate, Bob Stanley. <a href=\"https://www.last.fm/music/Pete+Wiggs\">Read more on Last.fm</a>. User-contributed text is available under the Creative Commons By-SA License; additional terms may apply.",
      "wikipedia_url": "https://en.wikipedia.org/wiki/Pete_Wiggs"
    }
  },
