{
  "name": "russ-fm-shadcn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "rm -rf dist && pnpm run generate-sitemap && tsc --noEmit && vite build && pnpm run process-images && pnpm run generate-colors && pnpm run build:wrapped && pnpm run generate-sitemap && pnpm run generate-og && pnpm run generate-static-meta",
    "generate-sitemap": "node scripts/generate-sitemap.mjs",
    "generate-colors": "node scripts/generate-album-colors.js",
    "generate-og": "node scripts/generate-og-images.mjs",
    "generate-static-meta": "node scripts/generate-static-meta.mjs",
    "build:fast": "rm -rf dist && pnpm run generate-sitemap && tsc --noEmit && vite build && pnpm run generate-static-meta",
    "build:generate-sync": "pnpm run build && pnpm run build:sync",
    "build:sync": "node scripts/sync-to-r2.js",
    "build:sync:dry": "node scripts/sync-to-r2.js --dry-run",
    "build:worker": "pnpm run build:fast && node scripts/build-worker.js",
    "build:worker-cloudflare": "node scripts/build-worker-cloudflare.js",
    "build:wrapped": "tsx scripts/generate-wrapped-data.ts",
    "deploy": "pnpm run build:worker && pnpm exec wrangler deploy",
    "deploy:preview": "pnpm run build:worker && pnpm exec wrangler deploy --env preview",
    "process-images": "tsx scripts/process-images.js",
    "cleanup-images": "tsx scripts/cleanup-old-images.js",
    "check-corrupted-images": "tsx scripts/check-corrupted-images.js",
    "r2:list": "node scripts/r2-utils.js list",
    "r2:clean": "node scripts/r2-utils.js clean --confirm",
    "clear-cache": "./clear-cache.sh",
    "lint": "eslint .",
    "preview": "vite preview --outDir dist-worker"
  },
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource-variable/inter-tight": "^5.2.7",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@plausible-analytics/tracker": "^0.4.5",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-progress": "^1.1.11",
    "@radix-ui/react-select": "^2.3.2",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.2",
    "@radix-ui/react-tabs": "^1.1.16",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@types/d3": "^7.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "d3": "^7.9.0",
    "framer-motion": "^12.42.1",
    "fuse.js": "^7.4.2",
    "lucide-react": "^0.525.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "react-is": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1076.0",
    "@aws-sdk/lib-storage": "^3.1076.0",
    "@eslint/js": "^9.39.4",
    "@fontsource/inter": "^5.2.8",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.2",
    "chalk": "^5.6.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "glob": "^11.1.0",
    "globals": "^16.5.0",
    "ora": "^8.2.0",
    "postcss": "^8.5.25",
    "satori": "^0.18.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "terser": "^5.48.0",
    "tsx": "^4.22.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.3.6",
    "wrangler": "^3.114.17"
  }
}
