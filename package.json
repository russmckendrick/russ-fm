{
  "name": "russ-fm-shadcn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "rm -rf dist && tsc --noEmit && vite build && pnpm run process-images && pnpm run generate-colors && pnpm run build:wrapped && pnpm run generate-og",
    "generate-colors": "node scripts/generate-album-colors.js",
    "generate-og": "node scripts/generate-og-images.mjs",
    "build:fast": "rm -rf dist && tsc --noEmit && vite build",
    "build:generate-sync": "pnpm run build && pnpm run build:sync",
    "build:sync": "node scripts/sync-to-r2.js",
    "build:sync:dry": "node scripts/sync-to-r2.js --dry-run",
    "build:worker": "pnpm run build:fast && node scripts/build-worker.js",
    "build:worker-cloudflare": "node scripts/build-worker-cloudflare.js",
    "build:wrapped": "tsx scripts/generate-wrapped-data.ts",
    "deploy": "pnpm run build:worker && pnpm exec wrangler deploy",
    "deploy:preview": "pnpm run build:worker && pnpm exec wrangler deploy --env preview",
    "process-images": "tsx scripts/process-images.js",
    "cleanup-images": "tsx scripts/cleanup-old-images.js",
    "check-corrupted-images": "tsx scripts/check-corrupted-images.js",
    "r2:list": "node scripts/r2-utils.js list",
    "r2:clean": "node scripts/r2-utils.js clean --confirm",
    "clear-cache": "./clear-cache.sh",
    "lint": "eslint .",
    "preview": "vite preview --outDir dist-worker"
  },
  "packageManager": "pnpm@10.23.0",
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource-variable/inter-tight": "^5.2.7",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@plausible-analytics/tracker": "^0.4.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/d3": "^7.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "d3": "^7.9.0",
    "framer-motion": "^12.38.0",
    "fuse.js": "^7.3.0",
    "lucide-react": "^0.525.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0",
    "react-is": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/lib-storage": "^3.1041.0",
    "@eslint/js": "^9.39.4",
    "@fontsource/inter": "^5.2.8",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "chalk": "^5.6.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "glob": "^11.1.0",
    "globals": "^16.5.0",
    "ora": "^8.2.0",
    "postcss": "^8.5.13",
    "satori": "^0.18.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "terser": "^5.46.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^7.3.2",
    "wrangler": "^3.114.17"
  }
}
